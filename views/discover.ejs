<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { pageTitle: 'Discover - NovelMaker' , pageCss: 'discover' }) %>

    <body>
        <div class="app-layout">
            <%- include('partials/navbar') %>

                <main class="page-main">
                    <div class="page-container">
                        <section class="explore-header">
                            <h1 class="explore-title">Discover</h1>
                            <p class="explore-subtitle">Discover stories written by the NovelMaker community.</p>
                        </section>

                        <hr class="section-divider">

                        <section class="stories-section">
                            <% if (!stories || stories.length===0) { %>
                                <div class="empty-stories-box">
                                    <p>No stories have been published yet.</p>
                                    <a href="/writer" class="btn-new-story">Write the first story</a>
                                </div>
                                <% } else { %>
                                    <div class="books-grid-4">
                                        <% stories.forEach(story=> { %>
                                            <div class="book-card-wrapper">
                                                <a href="/novel/<%= story._id %>" class="book-card-clean">
                                                    <div
                                                        class="book-cover <%= story.coverImage ? 'has-custom-cover' : story.coverTheme %>">
                                                        <div class="book-spine"></div>
                                                        <% if (story.coverImage) { %>
                                                            <img src="<%= story.coverImage %>" alt="<%= story.title %>"
                                                                class="book-cover-img">
                                                            <% } else { %>
                                                                <div class="book-cover-content">
                                                                    <h3 class="book-cover-title">
                                                                        <%= story.title %>
                                                                    </h3>
                                                                </div>
                                                                <% } %>
                                                    </div>
                                                    <span class="book-clean-title">
                                                        <%= story.title %>
                                                    </span>
                                                </a>

                                                <% if (story.author) { %>
                                                    <a href="/profile/<%= story.author.username %>"
                                                        class="book-author-link">
                                                        by <%= story.author.nickname || story.author.username %>
                                                    </a>
                                                    <% } %>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } %>
                        </section>
                    </div>
                </main>
        </div>

        <script src="/js/script.js"></script>
    </body>

</html>