<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { pageTitle: 'Sign In', pageCss: 'login' }) %>

<body>

    <div class="app-layout">
        <%- include('partials/navbar') %>

        <main class="auth-main">
            <div class="auth-card">
                <div class="auth-header">
                    <h1 class="auth-logo">NovelMaker</h1>
                    <p class="auth-subtitle" id="auth-subtitle">
                        <%= mode === 'register' ? 'Create your author account to start writing.' : 'Sign in to continue your manuscript.' %>
                    </p>
                </div>

                <!-- Switch Tabs -->
                <div class="auth-tabs">
                    <button type="button" class="auth-tab <%= mode !== 'register' ? 'active' : '' %>" data-target="form-login">Sign In</button>
                    <button type="button" class="auth-tab <%= mode === 'register' ? 'active' : '' %>" data-target="form-register">Create Account</button>
                </div>

                <% if (error) { %>
                    <div class="auth-error"><%= error %></div>
                <% } %>

                <!-- Sign In Form -->
                <form action="/login" method="POST" class="auth-form <%= mode === 'register' ? 'hidden' : '' %>" id="form-login">
                    <div class="form-group">
                        <label for="login-email">Email</label>
                        <input type="email" id="login-email" name="email" placeholder="author@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="login-password">Password</label>
                        <input type="password" id="login-password" name="password" placeholder="••••••••" required>
                    </div>

                    <button type="submit" class="btn-auth-submit">Sign In & Write</button>
                </form>

                <!-- Register Form -->
                <form action="/register" method="POST" class="auth-form <%= mode !== 'register' ? 'hidden' : '' %>" id="form-register">
                    <div class="form-group">
                        <label for="reg-nickname">Nickname</label>
                        <input type="text" id="reg-nickname" name="nickname" placeholder="Elena Vance" maxlength="40" required>
                    </div>

                    <div class="form-group">
                        <label for="reg-username">Handle (@)</label>
                        <input type="text" id="reg-username" name="username" placeholder="elenavance" maxlength="25" required>
                    </div>

                    <div class="form-group">
                        <label for="reg-email">Email</label>
                        <input type="email" id="reg-email" name="email" placeholder="author@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="reg-password">Password</label>
                        <input type="password" id="reg-password" name="password" placeholder="Create a password" minlength="6" required>
                    </div>

                    <button type="submit" class="btn-auth-submit">Create Account</button>
                </form>
            </div>
        </main>
    </div>

    <script src="/js/script.js"></script>
    <script src="/js/login.js"></script>
</body>

</html>