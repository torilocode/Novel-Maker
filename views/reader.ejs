<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { pageTitle: `${story.title} - NovelMaker`, pageCss: 'reader' }) %>

    <body>
        <div class="app-layout">
            <%- include('partials/navbar') %>

                <main class="reader-main">
                    <div class="reader-container" id="reader-root"
                        data-chapters="<%= JSON.stringify(story.chapters || []) %>">

                        <div class="reader-header">
                            <h1 class="reader-title">
                                <%= story.title %>
                            </h1>
                            <div class="reader-meta">
                                <span>
                                    By <a href="/profile/<%= story.author.username %>">
                                        <%= story.author.nickname || story.author.username %>
                                    </a> (@<%= story.author.username %>)
                                </span>

                                <% if (isAuthor) { %>
                                    <a href="/writer/<%= story._id %>" class="reader-btn">
                                        <i data-lucide="pen-line"></i>
                                        Edit Story
                                    </a>
                                    <% } %>
                            </div>
                        </div>

                        <% if (story.chapters && story.chapters.length> 0) { %>
                            <div class="chapter-selector">
                                <label for="chapter-select">Chapter:</label>
                                <select id="chapter-select">
                                    <% story.chapters.forEach((ch, index)=> { %>
                                        <option value="<%= index %>">
                                            <%= ch.title || ('Chapter ' + (index + 1)) %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <article>
                        <h2 class="chapter-heading" id="chapter-title"></h2>
                        <div class="chapter-body" id="chapter-content"></div>
                    </article>

                    <div class="chapter-nav-buttons">
                        <button type="button" class="reader-btn" id="prev-chapter-btn">
                            <i data-lucide="arrow-left"></i> Previous
                        </button>
                        <button type="button" class="reader-btn" id="next-chapter-btn">
                            Next <i data-lucide="arrow-right"></i>
                        </button>
                    </div>
                <% } else { %>
                    <p class="reader-empty-state">This story doesn' t have any chapters yet.</p>
                                                <% } %>
                            </div>
                </main>
        </div>

        <script src="/js/script.js"></script>
        <script src="/js/reader.js"></script>
    </body>

</html>